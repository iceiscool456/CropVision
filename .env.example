# Copy this file to ".env" and fill in your key.
# The .env file is gitignored and never committed.

# Pl@ntNet API key — get a free one (500 identifications/day) at:
#   https://my.plantnet.org/  →  Settings → API Key
PLANTNET_API_KEY=your-key-here

# (Optional) Plant.id / Kindwise key for accurate disease diagnosis ("Deep
# diagnosis" button). Free trial credits on signup, then paid (1 credit/call).
# Register at: https://admin.kindwise.com/signup
# Leave blank to keep the feature disabled (no cost).
PLANTID_API_KEY=
